# Copia questo file in ".env" e compilalo. NON committare mai ".env".
# --- AI (lascia vuoto quello che non usi) ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
# Modelli locali gratuiti con Ollama (es. http://host.docker.internal:11434 oppure http://IP-NAS:11434)
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
# --- Sicurezza ---
# Se lo imposti, chi usa AIDA deve scriverlo in Impostazioni → «Codice di accesso»
ACCESS_CODE=
RATE_LIMIT=20
FREE_DAILY_CAP=40
MAX_TOKENS=700
# --- Tailscale (solo per docker-compose.tailscale.yml) ---
TS_AUTHKEY=
TS_HOSTNAME=aida
